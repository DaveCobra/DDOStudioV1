# .NET build output
bin/
obj/
artifacts/
publish/

# Visual Studio / Rider / VS Code user state
.vs/
.idea/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates

# Test and coverage output
TestResults/
coverage/
*.coverage
*.coveragexml

# NuGet packages and generated package files
packages/
*.nupkg
*.snupkg

# Installer output
installer/Output/
Output/

# Packaged/staged build output
release/

# Build-script download cache (three.js and viewer loaders)
.build-cache/

# MSBuild diagnostic logs
*.binlog

# Runtime logs, caches, and local data
*.log
cache/
temp/
tmp/

# Machine-local NuGet feed config (hardcodes a local SDK output path)
/NuGet.config

# Agent/editor local state
.claude/settings.local.json

# Editor scratch and merge leftovers
*~
*.swp
*.bak
*.orig
*.rej
*.tmp

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local DDO data files (not distributable source)
*.dat
*.datx
